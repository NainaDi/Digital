<section class="story"><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2><p>{{ section.settings.text }}</p></section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Slow by intention"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rooted in craft"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "A standalone Shopify Online Store 2.0 theme connected to dynamic products, collections, cart, search, and navigation."
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
