<main>
  <header class="page-hero reveal">
    <p class="eyebrow">The archive</p>
    <h1 class="display" id="collectionTitle">{{ collection.title | default: 'All Pieces' }}</h1>
    {% if collection.description != blank %}<p id="collectionDescription">{{ collection.description }}</p>{% else %}<p id="collectionDescription">An evolving archive of handworked clothing and objects.</p>{% endif %}
  </header>

  <section class="shell" aria-label="Collection products">
    {% paginate collection.products by 24 %}
      <div class="filter-bar">
        <div class="collection-tools">
          <a class="collection-tool" href="{{ routes.collections_url }}"><span>Collections</span></a>
          <span class="collection-tool"><span>Sort</span><small>{{ collection.sort_by | default: collection.default_sort_by | replace: '-', ' ' | capitalize }}</small></span>
        </div>
        <nav class="collection-subnav" aria-label="Browse product categories">
          <div class="collection-subnav-track">
            <a href="{{ routes.all_products_collection_url }}"{% if collection.handle == 'all' %} class="is-active" aria-current="page"{% endif %}>All</a>
            {% for link in linklists.main-menu.links %}
              {% if link.type == 'collection_link' %}<a href="{{ link.url }}"{% if link.object.handle == collection.handle %} class="is-active" aria-current="page"{% endif %}>{{ link.title }}</a>{% endif %}
            {% endfor %}
          </div>
        </nav>
        <span class="collection-count"><span class="collection-count-number">{{ collection.products_count }}</span><span class="collection-count-label"> {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</span></span>
      </div>

      <div class="collection-grid" id="collectionGrid" aria-live="polite">
        {% for product in collection.products %}
          {% render 'product-card', product: product, fallback_index: forloop.index %}
        {% else %}
          <div class="no-results"><p class="eyebrow">No pieces found</p><h2 class="display">Try another collection</h2></div>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}<div class="pagination-wrap">{{ paginate | default_pagination }}</div>{% endif %}
    {% endpaginate %}
  </section>
</main>
{% schema %}{"name":"Main collection"}{% endschema %}
