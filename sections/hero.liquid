<section class="hero">
  <div class="heroCopy">
    <p class="eyebrow">✦ {{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
    <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }} {% render 'icon', icon: 'arrow' %}</a>
  </div>
  <div class="heroCard">
    {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'eager' }}{% endif %}
    <div class="sun"></div><h2>{{ section.settings.card_heading }}</h2><p>{{ section.settings.card_text }}</p>
  </div>
</section>
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Char Bagh Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Slow fashion for beautifully imperfect days."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Natural textures, botanical color, and airy silhouettes arranged for a commerce-ready digital impression."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the edit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "card_heading",
      "label": "Card heading",
      "default": "Rooted in craft"
    },
    {
      "type": "textarea",
      "id": "card_text",
      "label": "Card text",
      "default": "Botanical color, airy silhouettes, and commerce-ready Shopify data."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
