<section class="products"><div class="sectionTitle"><p class="eyebrow">Featured pieces</p><h2>{{ section.settings.heading }}</h2></div><div class="productGrid">{% assign featured_collection = collections[section.settings.collection] %}{% for product in featured_collection.products limit: section.settings.products_to_show %}{% render 'product-card', product: product, fallback_index: forloop.index %}{% else %}{% for product in collections.all.products limit: section.settings.products_to_show %}{% render 'product-card', product: product, fallback_index: forloop.index %}{% else %}{% for i in (1..4) %}{% render 'product-card', fallback_index: i %}{% endfor %}{% endfor %}{% endfor %}</div></section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collection highlights"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
