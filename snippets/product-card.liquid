<article class="product-card">
  <a href="{{ product.url | default: '#' }}" class="product-card__media" aria-label="{{ product.title | default: 'Product' | escape }}">
    {% if product.featured_media %}
      {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 90vw', widths: '300,500,700', alt: product.featured_media.alt | default: product.title }}
    {% else %}
      <span>{{ fallback_index | default: 1 | prepend: '0' | slice: -2, 2 }}</span>
    {% endif %}
  </a>
  <h3><a href="{{ product.url | default: '#' }}">{{ product.title | default: 'Char Bagh Kurta Set' }}</a></h3>
  {% if product.description != blank %}<p>{{ product.description | strip_html | truncate: 82 }}</p>{% endif %}
  <strong>{% if product.price %}{% render 'price', product: product %}{% else %}{{ 'products.product.from_price_html' | t: price: '₹8,900' }}{% endif %}</strong>
</article>
